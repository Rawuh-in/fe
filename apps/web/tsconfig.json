{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@event-organizer/ui": ["../../packages/ui/src/index.ts"],
      "@event-organizer/ui/*": ["../../packages/ui/src/*"],
      "@event-organizer/config": ["../../packages/config/src/index.ts"],
      "@event-organizer/config/*": ["../../packages/config/src/*"],
      "@event-organizer/services": ["../../packages/services/src/index.ts"],
      "@event-organizer/services/*": ["../../packages/services/src/*"]
    },
    "jsx": "preserve",
    "plugins": [
      {
        "name": "next"
      }
    ],
    "incremental": true
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
